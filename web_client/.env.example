# MySQL（也可只设置完整的 JOKER_WEB_DATABASE_URL）
JOKER_WEB_MYSQL_HOST=127.0.0.1
JOKER_WEB_MYSQL_PORT=3306
JOKER_WEB_MYSQL_DATABASE=joker_portal
JOKER_WEB_MYSQL_USER=joker_web
JOKER_WEB_MYSQL_PASSWORD=replace_with_a_strong_mysql_password
# JOKER_WEB_DATABASE_URL=mysql+pymysql://joker_web:password@127.0.0.1:3306/joker_portal?charset=utf8mb4

# 必须改为两个不同的长随机值，生产环境建议至少 32 字节
JOKER_WEB_SESSION_SECRET=replace_with_a_long_random_session_secret
JOKER_WEB_CARD_PEPPER=replace_with_a_different_long_random_card_pepper

JOKER_WEB_PORTAL_NAME=Joker 群管客户中心
# 生产环境由 Nginx 终止 HTTPS；保持回环监听，勿改为 0.0.0.0。
JOKER_WEB_HOST=127.0.0.1
JOKER_WEB_PORT=8765
# Linux 安装脚本会从已验证域名自动写入；仅当 CDN 丢失 X-Forwarded-* 时给 Windows 同步使用。
# JOKER_WEB_PUBLIC_ORIGIN=https://panel.example.com
# 管理后台路径；例如 /control-panel。留空或删除此项使用 /admin。
JOKER_WEB_ADMIN_PATH=/admin
# Cookie 有效期（秒，300～2592000）；也可在管理员后台“安全设置”中修改
JOKER_WEB_SESSION_MAX_AGE=604800

# 数据模式：
# local  = 网页与 AstrBot 位于同一台机器并直接读取插件数据（旧模式）
# remote = AstrBot 在本地电脑，服务器网页只通过同步 API 调取脱敏配置（推荐）
JOKER_WEB_DATA_MODE=remote
# 至少 32 位随机值；同时填入本地 AstrBot 插件设置的“远程网页同步 -> 同步令牌”
JOKER_WEB_SYNC_TOKEN=replace_with_a_long_random_sync_token
# 超过多少秒未收到本地同步后，网页标记机器人离线
JOKER_WEB_OFFLINE_AFTER_SECONDS=180

# SCUM search and server detail lookups use the BattleMetrics relay only.
# This key is the relay server's RELAY_API_KEY and must remain private.
SCUM_RELAY_URL=https://ba.yooyun.top
SCUM_RELAY_KEY=replace_with_scum_relay_key
# 多用户同时保存时的 MySQL 连接池上限。默认 10 个常驻连接 + 10 个临时连接；
# 数据库规格足够时可适当上调，保存等待超过该秒数会快速返回“稍后重试”。
JOKER_WEB_DATABASE_POOL_SIZE=10
JOKER_WEB_DATABASE_MAX_OVERFLOW=10
JOKER_WEB_DATABASE_POOL_TIMEOUT=5
# 单次 Windows 同步超过该秒数会返回可重试的 503，避免 Nginx/Cloudflare 产生 502。
JOKER_WEB_SYNC_EXCHANGE_TIMEOUT=40

# Official QQ bot dashboard proxy. The token is the dashboard token configured
# in joker_qq_admin, not the QQ AppSecret.
JOKER_OFFICIAL_BOT_URL=https://bbt.yooyun.top
JOKER_OFFICIAL_BOT_TOKEN=replace_with_official_dashboard_token
JOKER_OFFICIAL_BOT_TIMEOUT=10

# 本机 HTTP 调试设为 false；配置 HTTPS 反向代理后改为 true
JOKER_WEB_SECURE_COOKIES=false
