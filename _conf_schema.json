            "description": "背景颜色",
            "type": "string",
            "default": "#ffffff",
            "hint": "文转图时使用的背景颜色（十六进制）"
          },
          "line_spacing": {
            "description": "行间距",
            "type": "int",
            "default": 4,
            "hint": "文转图时的行间距（像素）"
          },
          "padding": {
            "description": "内边距",
            "type": "int",
            "default": 20,
            "hint": "图片边缘与文字的距离（像素）"
          },
          "modify_permission": {
            "description": "修改权限",
            "type": "string",
            "default": "admin",
            "options": ["admin", "owner"],
            "hint": "谁可以开关文转图功能"
          }
        }
      },
      "welcome": {
        "description": "入群欢迎",
        "type": "object",
        "items": {
          "enable_welcome": {
            "description": "启用入群欢迎",
            "type": "bool",
            "default": false,
            "hint": "仅在白名单或已授权且已开机群发送；未授权/关机群保持静默"
          },
          "enable_auto_welcome": {
            "description": "启用自动欢迎",
            "type": "bool",
            "default": false,
            "hint": "自动检测新成员并发送欢迎消息；当前按入群事件即时处理，发送仍受授权和开机门禁限制"
          },
          "welcome_check_interval": {
            "description": "欢迎检查间隔",
            "type": "int",
            "default": 30,
            "hint": "兼容旧配置项；当前使用入群事件即时处理，不会额外延迟欢迎消息"
          },
          "default_welcome_delay": {
            "description": "默认欢迎延迟",
            "type": "int",
            "default": 0,
            "hint": "入群欢迎消息的默认延迟发送时间（秒）"
          },
          "default_welcome_message": {
            "description": "默认欢迎消息",
            "type": "text",
            "default": "欢迎 {user_name} 加入本群！",
            "hint": "支持变量: {user_id}, {user_name}, {group_id}, {time}；未通过发送门禁时不会发送"
          },
          "enable_farewell": {
            "description": "启用退群通知",
            "type": "bool",
            "default": false,
            "hint": "成员退群时发送通知；通知同样受授权/白名单和开机发送门禁限制"
          },
          "default_farewell_message": {
            "description": "默认退群消息",
            "type": "text",
            "default": "{user_name} 离开了本群",
            "hint": "支持变量: {user_id}, {user_name}, {group_id}, {time}；未通过发送门禁时不会发送"
          },
          "welcome_keywords": {
            "description": "欢迎触发关键词",
            "type": "list",
            "items": {
              "type": "string"
            },
            "default": ["欢迎", "welcome", "入群"],
            "hint": "当群内消息包含这些关键词时触发欢迎消息"
          },
          "at_new_member": {
            "description": "艾特新人",
            "type": "bool",
            "default": true,
            "hint": "发送入群欢迎消息时是否艾特新成员；可使用 /设置艾特新人 覆盖当前群设置"
          },
          "auto_reply_enabled": {
            "description": "启用自动回复",
            "type": "bool",
            "default": true,
            "hint": "兼容欢迎系统的关键词自动回复开关；所有实际发送仍受授权/白名单和开机门禁限制"
          },
          "use_permission": {
            "description": "使用权限",
            "type": "string",
            "default": "member",
            "options": ["member", "admin", "owner"],
            "hint": "谁可以触发欢迎消息"
          },
          "modify_permission": {
            "description": "修改权限",
            "type": "string",
            "default": "admin",
            "options": ["admin", "owner"],
            "hint": "谁可以设置欢迎语等配置"
          }
        }
      },
      "keyword_filter": {
        "description": "关键词过滤",
        "type": "object",
        "items": {
          "enable_keyword_filter": {
            "description": "启用关键词过滤",
            "type": "bool",
            "default": false,
            "hint": "是否启用全局关键词过滤功能"
          },
          "filter_keywords": {
            "description": "过滤关键词",
            "type": "list",
            "items": {
              "type": "string"
            },
            "default": ["广告", "推广", "二维码", "vx", "微信", "qq", "群号", "拉人"],
            "hint": "包含这些关键词的消息将被处理"
          },
          "filter_regex_patterns": {
            "description": "过滤正则模式",
            "type": "list",
            "items": {
              "type": "string"
            },
            "default": [],
            "hint": "匹配这些正则表达式的消息将被处理"
          },
          "filter_action": {
            "description": "过滤动作",
            "type": "string",
            "default": "warn",
            "options": ["warn", "delete", "delete_warn", "mute", "kick", "blacklist"],
            "hint": "warn（警告）/ delete（仅撤回）/ delete_warn（撤回并警告）/ mute（禁言）/ kick（踢出）/ blacklist（拉黑）"
          },
          "filter_mute_duration": {
            "description": "过滤禁言时长",
            "type": "int",
            "default": 300,
            "hint": "触发过滤后禁言的时长（秒）"
          },
          "warn_message": {
            "description": "警告消息",
            "type": "text",
            "default": "⚠️ 您的消息包含敏感内容，请遵守群规！",
            "hint": "触发 warn 动作时发送；禁言失败也会使用。支持变量: {user_id}, {group_id}, {keyword}"
          },
          "warning_messages": {
            "description": "随机警告消息",
            "type": "list",
            "items": {
              "type": "string"
            },
            "default": ["⚠️ 您的消息包含敏感内容，请遵守群规！"],
            "hint": "warn 或 delete_warn 时从列表随机选择；为空时回退到上方单条警告消息。支持变量: {user_id}, {group_id}, {keyword}"
          },
          "mute_message": {
            "description": "禁言提示消息",
            "type": "text",
            "default": "{user_id} 已被禁言，请遵守群规。",
            "hint": "触发 mute 动作成功后发送。支持变量: {user_id}, {group_id}, {keyword}"
          },
          "kick_message": {
            "description": "踢出提示消息",
            "type": "text",
            "default": "{user_id} 已被移出本群。",
            "hint": "触发 kick 动作成功后发送。支持变量: {user_id}, {group_id}, {keyword}"
          },
          "blacklist_message": {
            "description": "拉黑提示消息",
            "type": "text",
            "default": "{user_id} 已加入黑名单。",
            "hint": "触发 blacklist 动作成功后发送。支持变量: {user_id}, {group_id}, {keyword}"
          },
          "enable_log": {
            "description": "启用日志记录",
            "type": "bool",
            "default": true,
            "hint": "是否记录关键词过滤事件"
          },
          "admin_bypass_filter": {
            "description": "管理员跳过过滤",
            "type": "bool",
            "default": true,
            "hint": "管理员和群主是否不受关键词过滤限制"
          },
          "use_permission": {
            "description": "使用权限",
            "type": "string",
            "default": "admin",
            "options": ["member", "admin", "owner"],
            "hint": "谁可以使用关键词过滤相关命令"
          },
          "modify_permission": {
            "description": "修改权限",
            "type": "string",
            "default": "admin",
            "options": ["admin", "owner"],
            "hint": "谁可以设置关键词过滤配置"
          }
        }
      },
      "player_reply": {
        "description": "用户专属回复",
        "type": "object",
        "items": {
          "enable_player_reply": {
            "description": "启用用户专属回复",
            "type": "bool",
            "default": true,
            "hint": "是否启用用户专属回复功能"
          },
          "use_permission": {
            "description": "使用权限",
            "type": "string",
            "default": "admin",
            "options": ["member", "admin", "owner"],
            "hint": "谁可以添加/删除用户专属回复"
          },
          "default_at_user": {
            "description": "默认艾特用户",
            "type": "bool",
            "default": true,
            "hint": "新添加专属回复时是否默认艾特用户"
          },
          "enable_at_user": {
            "description": "发送时艾特用户",
            "type": "bool",
            "default": true,
            "hint": "触发专属回复发送消息时是否实际艾特用户（全局开关，关闭后所有用户专属回复都不艾特）"
          }
        }
      },
      "timed_message": {
        "description": "定时消息与定时禁言",
        "hint": "Cron 固定为五段“分 时 日 月 周”：周一=0、周日=6；支持 *、*/步长、范围和列表。示例：每天 09:00 为 0 9 * * *。",
        "type": "object",
        "items": {
          "enable_timed_message": {
            "description": "启用定时消息",
            "type": "bool",
            "default": false,
            "hint": "启用后可使用 /定时播报 HH:MM 内容、/定时播报 @全体 HH:MM 内容，或“分 时 日 月 周”五段 Cron 任务；只在白名单/授权且已开机群发送"
          },
          "use_permission": {
            "description": "使用权限",
            "type": "string",
            "default": "admin",
            "options": ["member", "admin", "owner"],
            "hint": "谁可以使用 /查看定时消息；添加、删除和开关任务使用下方修改权限"
          },
          "modify_permission": {
            "description": "修改权限",
            "type": "string",
            "default": "admin",
            "options": ["admin", "owner"],
            "hint": "谁可以添加、删除、清空或开关定时消息，以及添加定时全体禁言/解禁任务"
          }
        }
      },
      "sub_admin": {
        "description": "分群管理员",
        "type": "object",
        "items": {
          "enable_sub_admin": {
            "description": "启用分群管理员",
            "type": "bool",
            "default": false,
            "hint": "是否启用分群管理员功能"
          },
          "modify_permission": {
            "description": "修改权限",
            "type": "string",
            "default": "owner",
            "options": ["admin", "owner"],
            "hint": "谁可以添加/删除分群管理员"
          }
        }
      }
    }
  }
}
