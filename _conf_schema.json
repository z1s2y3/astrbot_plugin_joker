{
  "basic": {
    "description": "基础设置",
    "hint": "全局基础配置，包括白名单、主人账号等",
    "type": "object",
    "items": {
      "whitelist_groups": {
        "description": "白名单群组",
        "type": "list",
        "items": {
          "type": "string"
        },
        "default": [],
        "hint": "白名单群绕过授权、开机和 SCUM 查询关键词限制；绑定/解绑等命令仍受自身管理员/群主权限检查"
      },
      "admin_groups": {
        "description": "管理员群组",
        "type": "list",
        "items": {
          "type": "string"
        },
        "default": [],
        "hint": "需要管理员权限才能使用绑定/解绑功能的群组"
      },
      "owner_ids": {
        "description": "主人账号",
        "type": "list",
        "items": {
          "type": "string"
        },
        "default": [],
        "hint": "全局主人账号ID列表；主人使用授权管理、卡密和网页同步控制命令不受群开关机限制，普通业务/群管命令仍须群已开机"
      },
      "filter_groups": {
        "description": "过滤群组",
        "type": "list",
        "items": {
          "type": "string"
        },
        "default": [],
        "hint": "关键词过滤命令维护的群组列表"
      },
      "allow_slash_prefix": {
        "description": "启用命令功能",
        "type": "bool",
        "default": true,
        "hint": "是否允许使用插件命令（关闭后所有命令不可用）"
      },
      "enable_help": {
        "description": "启用帮助功能",
        "type": "bool",
        "default": true,
        "hint": "是否启用帮助命令（帮助）"
      },
      "enable_settings": {
        "description": "启用群组设置功能",
        "type": "bool",
        "default": true,
        "hint": "是否启用群组设置相关命令"
      }
    }
  },
  "web_sync": {
    "description": "绑定 Linux 网页配置中心",
    "hint": "可选。Linux 网页是游戏和分群配置中心，Windows AstrBot 只负责主动同步和实际执行；首次连接仍需要在执行端完成网页地址、同步令牌和 Card Pepper 的引导。",
    "type": "object",
    "items": {
      "enabled": {
        "description": "启用 Linux 网页绑定",
        "type": "bool",
        "default": false,
        "hint": "启用后，本机机器人会定期上传分群配置并拉取网页端已保存的配置；网页断开不会影响机器人继续运行。"
      },
      "portal_url": {
        "description": "Linux 网页 HTTPS 地址",
        "type": "string",
        "default": "",
        "hint": "首次引导时填写反向代理后的实际 HTTPS 域名，例如 https://web.example.com；网页同步成功后会自动下发公网来源，后台 WebSocket 页面无需重复填写。不要填写服务器 IP、SSH 端口、账号密码、查询参数或末尾斜杠。"
      },
      "sync_token": {
        "description": "网页同步令牌",
        "type": "string",
        "default": "",
        "hint": "至少 32 位随机值，必须与 Linux 服务器 JOKER_WEB_SYNC_TOKEN 完全相同。它不是网页登录密码，也不是 SSH 密码。"
      },
      "music_source_services": {
        "description": "后台音乐源服务",
        "type": "object",
        "items": {},
        "default": {},
        "hint": "由 Linux 管理后台通过认证心跳下发的内部映射；请勿在 Windows 端手动填写。"
      },
      "game_executor": {
        "description": "后台游戏插件连接",
        "type": "object",
        "items": {},
        "default": {},
        "hint": "由 Linux 管理后台通过认证心跳下发的内部映射；请勿在 Windows 端手动填写。"
      },
      "im3_socketio": {
        "description": "后台 im3 连接",
        "type": "object",
        "items": {},
        "default": {},
        "hint": "由 Linux 管理后台通过认证心跳下发的内部映射；请勿在 Windows 端手动填写。"
      },
      "game_websocket_enabled": {
        "description": "后台游戏 WebSocket 开关",
        "type": "bool",
        "default": false,
        "hint": "由 Linux 管理后台自动下发；固定为 /api/sync/v1/ws，Windows 端无需手动修改。"
      },
      "game_websocket_endpoint_path": {
        "description": "后台游戏 WebSocket 路径",
        "type": "string",
        "default": "/api/sync/v1/ws",
        "hint": "由 Linux 管理后台下发；请在网页后台修改。"
      },
      "game_websocket_token": {
        "description": "后台游戏 WebSocket 入口令牌",
        "type": "string",
        "default": "",
        "hint": "由 Linux 管理后台在认证同步后下发。它与 web_sync.sync_token（网页同步令牌）完全不同，请勿手动填写或把两者设为同一值。"
      },
      "card_pepper": {
        "description": "卡密指纹盐（Card Pepper）",
        "type": "string",
        "default": "",
        "hint": "必须与 Linux 服务器 JOKER_WEB_CARD_PEPPER 完全相同，仅用于生成不可逆卡密指纹；网页不会收到原始卡密。两端不一致会导致卡密显示尚未同步。"
      },
      "interval_seconds": {
        "description": "同步检查间隔（秒）",
        "type": "int",
        "default": 5,
        "hint": "最小 3 秒，默认 5 秒。可在 QQ 中使用 /网页绑定状态 和 /测试网页连接 查看状态。"
      },
      "show_connection_events": {
        "description": "Windows CMD connection status",
        "type": "bool",
        "default": false,
        "hint": "Disabled by default; enable only when connection state changes should be written to the Windows group CMD."
      }
    }
  },
  "scum": {
    "description": "SCUM查询",
    "hint": "SCUM服务器查询和绑定相关配置。SCUM 查询可单独走中转地址，和群管网页同步隔离。",
    "type": "object",
    "items": {
      "enable_query": {
        "description": "启用查询功能",
        "type": "bool",
        "default": true
      },
      "enable_binding": {
        "description": "启用绑定功能",
        "type": "bool",
        "default": true
      },
      "default_enabled": {
        "description": "默认启用查询",
        "type": "bool",
        "default": true,
        "hint": "未在白名单中的群组是否需要绑定ID才能使用查询功能"
      },
      "allow_other_query": {
        "description": "允许查询其他服务器",
        "type": "bool",
        "default": true,
        "hint": "绑定ID后是否允许查询其他服务器（全局默认）"
      },
      "permission_mode": {
        "description": "权限模式",
        "type": "string",
        "default": "read_only",
        "options": ["read_only", "full_access"],
        "hint": "read_only: 仅允许使用，不允许修改配置；full_access: 完全访问"
      },
      "query_relay_url": {
        "description": "SCUM 查询专用中转地址",
        "type": "string",
        "default": "https://ba.yooyun.top",
        "hint": "SCUM 查询唯一入口，不会改变群管、成员、消息和配置同步地址。默认使用 https://ba.yooyun.top；该地址必须提供 /api/sync/v1/scum/query/<群号> 接口，并与网页同步令牌、Card Pepper 配套。"
      }
    }
  },
  "auth": {
    "description": "授权系统",
    "hint": "卡密授权相关配置",
    "type": "object",
    "items": {
      "enable_auth": {
        "description": "启用授权系统",
        "type": "bool",
        "default": false,
        "hint": "开启后非白名单且未授权群完全静默（不发送普通回复、入群欢迎、入群审核、定时播报和自动通知）；主人仅对授权管理控制命令绕过开机限制，普通业务命令仍须先开机"
      },
      "auth_key": {
        "description": "管理密钥",
        "type": "string",
        "default": "",
        "hint": "用于生成和验证卡密的密钥；启用授权前必须设置为随机长密钥"
      },
      "auto_delete_used_keys_days": {
        "description": "自动删除已用卡密天数",
        "type": "int",
        "default": 0,
        "hint": "自动删除超过该天数的已使用卡密记录（0表示不自动删除）"
      },
      "auth_detail_query": {
        "description": "授权查询显示详情",
        "type": "bool",
        "default": false,
        "hint": "开启后管理员可查看详细授权信息（包含激活时间和到期时间）"
      },
      "permission_mode": {
        "description": "权限模式",
        "type": "string",
        "default": "read_only",
        "options": ["read_only", "full_access"],
        "hint": "read_only: 仅允许查询授权状态；full_access: 允许生成卡密等管理操作"
      },
      "enable_auth_expire_reminder": {
        "description": "启用授权到期提醒",
        "type": "bool",
        "default": true,
        "hint": "开启后仅向仍通过发送门禁的已授权且开机群发送到期前提醒，并尝试艾特群主"
      },
      "auth_expire_reminder_hours": {
        "description": "提前提醒小时数",
        "type": "int",
        "default": 24,
        "hint": "在授权到期前多少小时发送提醒（默认24小时，建议6-48）"
      },
      "auth_expire_reminder_check_interval": {
        "description": "检查间隔(秒)",
        "type": "int",
        "default": 3600,
        "hint": "授权到期任务的检查间隔；实际检查不少于30秒，同一群重复提醒不少于60秒。提醒只发送到授权且已开机的群"
      },
      "auth_expire_reminder_at_owner": {
        "description": "艾特群主",
        "type": "bool",
        "default": true,
        "hint": "尝试艾特群主；无法获取群主QQ时仍发送普通文本提醒"
      },
      "auth_expire_reminder_message": {
        "description": "提醒消息模板",
        "type": "string",
        "default": "",
        "hint": "自定义提醒消息内容（留空使用默认模板）。可用变量: {group_id}群号, {expire_time}到期时间, {time_left}剩余时间"
      },
      "auth_expired_command_reply_interval": {
        "description": "授权过期回复间隔(秒)",
        "type": "int",
        "default": 3600,
        "hint": "仅针对保留授权记录且已开机的过期群，在执行显式斜杠指令时提示续费；这是回复间隔，不是自动提醒间隔。0=每次提示"
      },
      "auth_expired_command_reply_message": {
        "description": "授权过期提示消息",
        "type": "text",
        "default": "授权已过期，请联系管理员购买或续费授权。",
        "hint": "仅对授权记录仍保留、群已开机且发送显式指令的非主人显示；未授权群始终静默。支持变量: {group_id}。留空使用默认消息"
      },
      "allow_owner_when_expired": {
        "description": "过期授权允许主人测试",
        "type": "bool",
        "default": false,
        "hint": "开启后主人可在已开机、授权已过期的群内测试；不会放行其他成员，也不会绕过关机状态"
      },
      "auto_delete_expired_auth": {
        "description": "自动删除过期授权",
        "type": "bool",
        "default": false,
        "hint": "授权过期不会立即关机；宽限期结束后先删除群配置并关机，再删除授权记录"
      },
      "auto_delete_expired_auth_days": {
        "description": "过期多少天后自动删除",
        "type": "int",
        "default": 0,
        "hint": "授权过期多少天后自动清理群配置和授权记录（0=过期即删除，7=保留7天后删除）"
      },
      "default_auth_days": {
        "description": "默认授权天数",
        "type": "int",
        "default": 30,
        "hint": "使用/添加授权命令时的默认授权天数"
      }
    }
  },
  "qqadmin": {
    "description": "QQ群管",
    "hint": "群管自动消息只在白名单或已授权且已开机群执行；未授权/关机群不发送任何插件消息",
    "type": "object",
    "items": {
      "enable_group_manage": {
        "description": "启用群管总开关",
        "type": "bool",
        "default": true,
        "hint": "是否启用群管功能总开关，开启后分群需授权才能使用群管功能"
      },
      "enable_group_config": {
        "description": "启用群设置",
        "type": "bool",
        "default": false,
        "hint": "是否启用 /群设置（兼容 /分群设置）以及启用功能、禁用功能、查看功能状态等分群配置命令"
      },
      "message_prompts": {
        "description": "群状态消息提示",
        "type": "object",
        "hint": "仅自定义已通过发送门禁的状态消息；未授权群、关机状态下的自动事件和入群通知仍保持静默",
        "items": {
          "power_on_prompt": {
            "description": "关机时开机提示",
            "type": "text",
            "default": "群管尚未开机，请先发送 /开机。",
            "hint": "已授权且已关机的群发送显式指令时提示；支持变量: {group_id}。留空使用默认消息"
          },
          "power_on_success": {
            "description": "开机成功提示",
            "type": "text",
            "default": "✅️ 已开机\n群管功能已启用，可以正常使用所有群管命令",
            "hint": "执行 /开机 成功后发送；支持变量: {group_id}。留空使用默认消息"
          },
          "power_off_success": {
            "description": "关机成功提示",
            "type": "text",
            "default": "❌️ 已关机\n群管功能已禁用，所有群管命令将不再响应",
            "hint": "执行 /关机 成功后发送；支持变量: {group_id}。留空使用默认消息"
          },
          "power_off_already": {
            "description": "重复关机提示",
            "type": "text",
            "default": "群管已关机，无需重复操作。",
            "hint": "群已关机时再次执行 /关机 发送；支持变量: {group_id}。留空使用默认消息"
          }
        }
      },
      "auto_sync_global_config": {
        "description": "自动同步全局配置",
        "type": "bool",
        "default": true,
        "hint": "当全局配置修改时，自动同步到所有已授权的分群"
      },
      "group_config": {
        "description": "群设置权限",
        "type": "object",
        "items": {
          "use_permission": {
            "description": "使用权限",
            "type": "string",
            "default": "admin",
            "options": ["member", "admin", "owner"]
          },
          "modify_permission": {
            "description": "修改权限",
            "type": "string",
            "default": "admin",
            "options": ["admin", "owner"]
          }
        }
      },
      "global_config": {
        "description": "全局配置权限",
        "type": "object",
        "items": {
          "use_permission": {
            "description": "使用权限",
            "type": "string",
            "default": "admin",
            "options": ["admin", "owner"]
          }
        }
      },
      "reply": {
        "description": "自动回复",
        "type": "object",
        "items": {
          "enable_reply": {
            "description": "启用自动回复功能",
            "type": "bool",
            "default": false
          },
          "default_reply_cooldown": {
            "description": "默认回复冷却",
            "type": "int",
            "default": 0,
            "hint": "自动回复的默认冷却时间（秒）"
          },
          "enable_keyword_reply": {
            "description": "启用关键词回复",
            "type": "bool",
            "default": true,
            "hint": "是否启用关键词匹配回复"
          },
          "enable_exact_match": {
            "description": "启用精确匹配",
            "type": "bool",
            "default": false,
            "hint": "是否要求完全匹配关键词才触发回复"
          },
          "max_reply_length": {
            "description": "最大回复长度",
            "type": "int",
            "default": 500,
            "hint": "自动回复的最大长度限制（字符）"
          },
          "cache_reply_images": {
            "description": "缓存图片回复",
            "type": "bool",
            "default": true,
            "hint": "开启后在后台把图片保存到本地，防止 QQ 临时图片地址过期；关闭后仍可发送原图片地址"
          },
          "reply_image_max_mb": {
            "description": "单张图片最大 MB",
            "type": "int",
            "default": 20,
            "hint": "允许缓存的单张图片大小，运行时限制为 1-100 MB"
          },
          "reply_image_download_concurrency": {
            "description": "图片缓存并发数",
            "type": "int",
            "default": 4,
            "hint": "同时缓存的图片数量，运行时限制为 1-8；网络较慢时建议保持默认值"
          },
          "reply_image_retry_interval": {
            "description": "图片缓存重试间隔",
            "type": "int",
            "default": 30,
            "hint": "缓存失败后再次触发该回复时，至少间隔多少秒重试；运行时限制为 30-86400 秒"
          },
          "use_permission": {
            "description": "使用权限",
            "type": "string",
            "default": "admin",
            "options": ["member", "admin", "owner"],
            "hint": "谁可以使用自动回复功能"
          },
          "modify_permission": {
            "description": "修改权限",
            "type": "string",
            "default": "admin",
            "options": ["admin", "owner"],
            "hint": "谁可以添加/修改/删除回复"
          }
        }
      },
      "lottery": {
        "description": "抽奖",
        "type": "object",
        "items": {
          "enable_lottery": {
            "description": "启用抽奖功能",
            "type": "bool",
            "default": false,
            "hint": "每群的奖项、概率、库存和文案在网页分群配置中维护；抽奖记录保存在 Windows 本地"
          },
          "use_permission": {
            "description": "使用权限",
            "type": "string",
            "default": "member",
            "options": ["member", "admin", "owner"]
          },
          "modify_permission": {
            "description": "修改权限",
            "type": "string",
            "default": "admin",
            "options": ["admin", "owner"]
          }
        }
      },
      "entertainment": {
        "description": "娱乐",
        "type": "object",
        "items": {
          "enable_entertainment": {
            "description": "启用娱乐功能",
            "type": "bool",
            "default": false,
            "hint": "提供骰子、猜拳和随机选择等轻量群互动；结果只在 Windows 本地生成"
          },
          "time_enabled": {
            "description": "启用当前时间",
            "type": "bool",
            "default": true
          },
          "dice_enabled": {
            "description": "启用骰子",
            "type": "bool",
            "default": true
          },
          "rps_enabled": {
            "description": "启用猜拳",
            "type": "bool",
            "default": true
          },
          "random_enabled": {
            "description": "启用随机选择",
            "type": "bool",
            "default": true
          },
          "like_enabled": {
            "description": "启用 QQ 点赞",
            "type": "bool",
            "default": true
          },
          "music_enabled": {
            "description": "启用点歌",
            "type": "bool",
            "default": true
          },
          "video_enabled": {
            "description": "启用视频搜索",
            "type": "bool",
            "default": true
          },
          "time_command": {
            "description": "时间命令",
            "type": "string",
            "default": "当前时间",
            "hint": "默认一个命令；多个命令用 |、逗号或中文顿号分隔，例如 当前时间|时间"
          },
          "dice_command": {
            "description": "骰子命令",
            "type": "string",
            "default": "骰子",
            "hint": "默认一个命令；多个命令用 |、逗号或中文顿号分隔，例如 骰子|掷骰"
